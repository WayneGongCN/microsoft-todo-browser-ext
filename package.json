{
  "name": "microsoft-todo-browser-ext",
  "version": "2.0.5",
  "private": true,
  "type": "module",
  "description": "Capture webpages, selections and links in Microsoft To Do.",
  "repository": "https://github.com/WayneGongCN/microsoft-todo-browser-ext",
  "author": "waynegong",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:acceptance": "NODE_ENV=production wxt build --mode acceptance",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format && npm test && npm run build",
    "postinstall": "wxt prepare",
    "lint": "eslint src tests *.ts *.mjs scripts --max-warnings 0",
    "format": "prettier --check src tests config scripts *.ts *.mjs *.json",
    "package": "node scripts/package.mjs",
    "package:edge": "wxt build --browser edge --mv3 && node scripts/package.mjs edge"
  },
  "dependencies": {
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
